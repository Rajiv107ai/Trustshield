# TrustShield AI — Environment Configuration Template
# Copy this file to .env for local Docker Compose and orchestration overrides.

# ==============================================================================
# 1. FastAPI Application Gateway
# ==============================================================================
PORT=8000
HOST=0.0.0.0
WORKERS=1
LOG_LEVEL=info
PYTHONPATH=/app/trustshield_project:/app/backend:/app

# Feature Toggles
SSE_ENABLED=true
INVESTIGATION_ENABLED=true
PROMETHEUS_ENABLED=true
REDIS_ENABLED=true
NEO4J_ENABLED=true

# ==============================================================================
# 2. Neo4j Graph Database Configuration
# ==============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URI=http://neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=trustshield_secret
NEO4J_AUTH=neo4j/trustshield_secret
NEO4J_PLUGINS=["apoc"]

# ==============================================================================
# 3. Redis In-Memory Feature Store & Distributed Cache
# ==============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==============================================================================
# 4. Observability & Monitoring (Prometheus + Grafana)
# ==============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=trustshield_admin

# ==============================================================================
# 5. Security & Authentication Configuration (Phase 2 Hardening)
# ==============================================================================
# Environment: 'development' or 'production' (in 'production', startup fails closed
# if auth is disabled, secrets are missing/weak, or default passwords are used)
TRUSTSHIELD_ENV=development

# Enforce authentication (true/false in dev; MUST be true in production)
TRUSTSHIELD_AUTH_ENABLED=true

# API Keys (minimum 16 characters in production; provide distinct secret keys)
TRUSTSHIELD_ADMIN_KEY=dev-admin-secret-key-32chars-long!
TRUSTSHIELD_API_KEY=dev-operator-api-key-32chars-long

# Validated CORS allowed origins (comma-separated; wildcards prohibited with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

