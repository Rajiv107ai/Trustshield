# Large datasets and archives
# Research/training data remains excluded, but the minimal read-only PIT history
# required by production serving is explicitly included below.
# All CSV files in synthetic_v2_1/ are required for a complete governed feature
# service: orders, buyers, sellers, returns, device_mapping, and catalog data.
data/
**/data/
!data/
!data/synthetic_v2_1/
!data/synthetic_v2_1/*.csv
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# Frontend build/dependency artifacts
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/

# Generated outputs
outputs/
artifacts/
logs/
*.log

# Notebooks / local experiments
*.ipynb
.ipynb_checkpoints/

# IDE / OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
